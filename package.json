{
  "name": "openclaw-litefuse-plugin",
  "version": "0.2.0",
  "description": "OpenClaw plugin for reporting AI agent execution traces to Litefuse. Supports multi-target and self-hosted Litefuse.",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "src",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "install": {
      "npmSpec": "openclaw-litefuse-plugin",
      "defaultChoice": "npm"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/litefuse/openclaw-litefuse-plugin.git"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "litefuse",
    "langfuse",
    "observability",
    "tracing",
    "llm"
  ],
  "dependencies": {
    "@langfuse/otel": "^5.3.0",
    "@langfuse/tracing": "^5.3.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@opentelemetry/sdk-trace-node": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
